{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://healthcare-api-jh30.onrender.com/api/v1",
        "EXPO_PUBLIC_API_URL": "https://healthcare-api-jh30.onrender.com/api/v1",
        "EXPO_PUBLIC_ENVIRONMENT": "production"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://healthcare-api-jh30.onrender.com/api/v1",
        "EXPO_PUBLIC_API_URL": "https://healthcare-api-jh30.onrender.com/api/v1",
        "EXPO_PUBLIC_ENVIRONMENT": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
