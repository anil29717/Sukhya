# Application
APP_NAME=Healthcare Platform API
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Database (PostgreSQL — used with Docker)
DATABASE_URL=postgresql://postgres:12345@localhost:5432/healthcare_db
# SQLite alternative for local dev without Docker:
# DATABASE_URL=sqlite:///./healthcare.db
# JWT
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default admin (created on first startup if no admin exists)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin@123456
DEFAULT_ADMIN_FULL_NAME=System Administrator

# Password reset token expiry (minutes)
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Storage — cloudinary (primary for medical PDFs), s3, or local
STORAGE_BACKEND=cloudinary
STORAGE_DUAL_WRITE_S3=true
LOCAL_STORAGE_PATH=./storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
S3_SIGNED_URL_EXPIRE_SECONDS=3600
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=lumina-health
MAX_UPLOAD_SIZE_MB=10

# Notifications
NOTIFICATIONS_ENABLED=true
SEED_DEMO_DATA=true
ADMIN_DB_COPY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_USE_TLS=true
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
