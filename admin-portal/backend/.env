# Standalone Admin Portal Backend Configuration
APP_NAME=Lumina Health Admin API
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Database - Connects to shared Render PostgreSQL database
DATABASE_URL=postgresql://patient_db_8wp9_user:qBcrus5V3HJkuAmEMaga3uEEZuoa7uGf@dpg-d8l6p6cvikkc73cfab6g-a.oregon-postgres.render.com/patient_db_8wp9

# JWT - Shares the same secret keys to validate core auth tokens
SECRET_KEY=dev-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default admin setup
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin@123456
DEFAULT_ADMIN_FULL_NAME=System Administrator

PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# CORS - Includes localhost:3001 (Admin Frontend server port)
CORS_ORIGINS=http://localhost:3001,http://localhost:3000,http://localhost:8081,http://localhost:8082,http://localhost:5173,http://localhost:5174

# Storage - Shares the same local storage files
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=d:/Projects/Booking/backend/storage
MAX_UPLOAD_SIZE_MB=10
NOTIFICATIONS_ENABLED=true
SMTP_FROM_EMAIL=noreply@example.com
